UI}&#10;&#10;  /* COMMUNICATION (the “composition”) */&#10;  @inv26 is_alarm_displayed = TRUE ⇔ alarm_state ∈ {Active, Acknowledged}&#10;  @inv27 alarm_state ∈ {Active, Acknowledged} ⇒ controller_state ∈ {VentilationOff_C, FailSafe_C}&#10;  @inv28 gui_state = PowerOff_GUI ⇔ controller_state = PowerOff_C&#10;&#10;events&#10;  event INITIALISATION&#10;  then&#10;    @act1 alarm_state ≔ Inactive&#10;    @act2 alarm_type ≔ NoAlarm&#10;    @act3 battery_level ≔ MAX_BATTERY_TIME&#10;    @act4 voltage_level ≔ MIN_VOLTAGE&#10;    @act5 pressure_reading ≔ MIN_PRESSURE_ALRM&#10;    @act6 temperature_reading ≔ MIN_TEMPERATURE&#10;&#10;    /* controller */&#10;    @act7 controller_state ≔ PowerOff_C&#10;    @act8 vent_mode ≔ PCV&#10;    @act9 resp_rate ≔ DEFAULT_RESP_RATE&#10;    @act10 insp_pressure ≔ DEFAULT_INSP_PRESSURE&#10;    @act11 ie_ratio ≔ DEFAULT_IE_RATIO&#10;    @act12 is_ventilating ≔ FALSE&#10;&#10;    /* gui */&#10;    @act13 gui_state ≔ PowerOff_GUI&#10;    @act14 is_alarm_displayed ≔ FALSE&#10;    @act15 is_gui_frozen ≔ FALSE&#10;  end&#10;&#10;&#10;  event PowerOn_System&#10;  where&#10;    @grd1 controller_state = PowerOff_C&#10;    @grd2 gui_state = PowerOff_GUI&#10;  then&#10;    @act1 controller_state ≔ StartUp_C&#10;    @act2 gui_state ≔ PowerOn_GUI&#10;  end&#10;&#10;  event StartSelfTest_System&#10;  where&#10;    @grd1 controller_state = StartUp_C&#10;    @grd2 gui_state = PowerOn_GUI&#10;  then&#10;    @act1 controller_state ≔ SelfTest_C&#10;    @act2 gui_state ≔ SelfTest_GUI&#10;  end&#10;&#10;  event SelfTestComplete_System&#10;  where&#10;    @grd1 controller_state = SelfTest_C&#10;    @grd2 gui_state = SelfTest_GUI&#10;  then&#10;    @act1 controller_state ≔ VentilationOff_C&#10;    @act2 gui_state ≔ Menu_GUI&#10;    @act3 is_ventilating ≔ FALSE&#10;  end&#10;&#10;  event NavigateToVentilation_GUI&#10;  where&#10;    @grd1 gui_state = Menu_GUI&#10;    @grd2 is_alarm_displayed = FALSE&#10;    @grd3 is_gui_frozen = FALSE&#10;  then&#10;    @act1 gui_state ≔ Ventilation_GUI&#10;  end&#10;&#10;  event SelectPCV_System&#10;  where&#10;    @grd1 gui_state = Ventilation_GUI&#10;    @grd2 controller_state = VentilationOff_C&#10;    @grd3 is_alarm_displayed = FALSE&#10;  then&#10;    @act1 vent_mode ≔ PCV&#10;  end&#10;&#10;  event SelectPSV_System&#10;  where&#10;    @grd1 gui_state = Ventilation_GUI&#10;    @grd2 controller_state = VentilationOff_C&#10;    @grd3 is_alarm_displayed = FALSE&#10;  then&#10;    @act1 vent_mode ≔ PSV&#10;  end&#10;&#10;  event StartVentilation_System_PCV&#10;  where&#10;    @grd1 gui_state = Ventilation_GUI&#10;    @grd2 controller_state = VentilationOff_C&#10;    @grd3 vent_mode = PCV&#10;    @grd4 is_alarm_displayed = FALSE&#10;    @grd5 is_gui_frozen = FALSE&#10;  then&#10;    @act1 controller_state ≔ PCV_C&#10;    @act2 gui_state ≔ Start_GUI&#10;    @act3 is_ventilating ≔ TRUE&#10;  end&#10;&#10;  event StartVentilation_System_PSV&#10;  where&#10;    @grd1 gui_state = Ventilation_GUI&#10;    @grd2 controller_state = VentilationOff_C&#10;    @grd3 vent_mode = PSV&#10;    @grd4 is_alarm_displayed = FALSE&#10;    @grd5 is_gui_frozen = FALSE&#10;  then&#10;    @act1 controller_state ≔ PSV_C&#10;    @act2 gui_state ≔ Start_GUI&#10;    @act3 is_ventilating ≔ TRUE&#10;  end&#10;&#10;  event StopVentilation_System&#10;  where&#10;    @grd1 gui_state = Start_GUI&#10;    @grd2 controller_state ∈ {PCV_C, PSV_C, FailSafe_C}&#10;    @grd3 is_alarm_displayed = FALSE&#10;  then&#10;    @act1 controller_state ≔ VentilationOff_C&#10;    @act2 gui_state ≔ Ventilation_GUI&#10;    @act3 is_ventilating ≔ FALSE&#10;    @act4 resp_rate ≔ DEFAULT_RESP_RATE&#10;    @act5 insp_pressure ≔ DEFAULT_INSP_PRESSURE&#10;  end&#10;&#10;event FreezeGUI&#10;where&#10;  @grd1 is_gui_frozen = FALSE&#10;  @grd2 controller_state ≠ PowerOff_C&#10;  @grd3 gui_state ≠ PowerOff_GUI&#10;then&#10;  @act1 gui_state ≔ Frozen_GUI&#10;  @act2 is_gui_frozen ≔ TRUE&#10;end&#10;&#10;&#10;  event UnfreezeGUI&#10;  where&#10;    @grd1 is_gui_frozen = TRUE&#10;    @grd2 is_alarm_displayed = FALSE&#10;  then&#10;    @act1 is_gui_frozen ≔ FALSE&#10;    @act2 gui_state ≔ Menu_GUI&#10;  end&#10;&#10;&#10;  event IncrementRespRate&#10;  where&#10;    @grd1 controller_state ∉ {PowerOff_C, FailSafe_C}&#10;    @grd2 resp_rate &lt; MAX_RESP_RATE&#10;  then&#10;    @act1 resp_rate ≔ resp_rate + 1&#10;  end&#10;&#10;  event DecrementRespRate&#10;  where&#10;    @grd1 controller_state ∉ {PowerOff_C, FailSafe_C}&#10;    @grd2 resp_rate &gt; MIN_RESP_RATE&#10;  then&#10;    @act1 resp_rate ≔ resp_rate − 1&#10;  end&#10;&#10;  event IncrementInspPressure&#10;  where&#10;    @grd1 controller_state ≠ FailSafe_C&#10;    @grd2 insp_pressure &lt; MAX_INSP_PRESSURE&#10;  then&#10;    @act1 insp_pressure ≔ insp_pressure + 1&#10;  end&#10;&#10;  event DecrementInspPressure&#10;  where&#10;    @grd1 controller_state ≠ FailSafe_C&#10;    @grd2 insp_pressure &gt; MIN_INSP_PRESSURE&#10;  then&#10;    @act1 insp_pressure ≔ insp_pressure − 1&#10;  end&#10;&#10;  event IncrementIERatio&#10;  where&#10;    @grd1 controller_state ≠ FailSafe_C&#10;    @grd2 ie_ratio &lt; MAX_IE_RATIO&#10;  then&#10;    @act1 ie_ratio ≔ ie_ratio + 1&#10;  end&#10;&#10;  event DecrementIERatio&#10;  where&#10;    @grd1 controller_state ≠ FailSafe_C&#10;    @grd2 ie_ratio &gt; MIN_IE_RATIO&#10;  then&#10;    @act1 ie_ratio ≔ ie_ratio − 1&#10;  end&#10;&#10;  event DecrementBattery&#10;  where&#10;    @grd1 battery_level &gt; 0&#10;  then&#10;    @act1 battery_level ≔ battery_level − 1&#10;&#10;  end&#10;&#10;  event ChangeVoltage&#10;  any v&#10;  where&#10;    @grd1 v ∈ 0‥(2∗CRITICAL_VOLTAGE_HIGH)&#10;  then&#10;    @act1 voltage_level ≔ v&#10;  end&#10;&#10;  event ChangePressure&#10;  any p&#10;  where&#10;    @grd1 p ∈ 0‥(2∗CRITICAL_PRESSURE_THRESHOLD)&#10;  then&#10;    @act1 pressure_reading ≔ p&#10;  end&#10;&#10;  event ChangeTemperature&#10;  any t&#10;  where&#10;    @grd1 t ∈ 0‥(2∗CRITICAL_TEMPERATURE_THRESHOLD)&#10;  then&#10;    @act1 temperature_reading ≔ t&#10;  end&#10;&#10;event ActivateBatteryAlarm&#10;where&#10;  @grd1 alarm_state = Inactive&#10;  @grd2 battery_level ≤ MIN_BATTERY_TIME&#10;then&#10;  @act1 alarm_state ≔ Active&#10;  @act2 alarm_type ≔ BatteryAlarm&#10;  @act3 is_alarm_displayed ≔ TRUE&#10;  @act4 is_gui_frozen ≔ FALSE&#10;  @act5 gui_state ≔ AlarmScreen_GUI&#10;  @act6 controller_state ≔ VentilationOff_C&#10;  @act7 is_ventilating ≔ FALSE&#10;end&#10;&#10;&#10;event ActivateVoltageAlarm&#10;where&#10;  @grd1 alarm_state = Inactive&#10;  @grd2 (voltage_level ≤ MIN_VOLTAGE ∨ voltage_level &gt; MAX_VOLTAGE)&#10;then&#10;  @act1 alarm_state ≔ Active&#10;  @act2 alarm_type ≔ VoltageAlarm&#10;  @act3 is_alarm_displayed ≔ TRUE&#10;&#10;  @act4 is_gui_frozen ≔ FALSE&#10;  @act5 gui_state ≔ AlarmScreen_GUI&#10;&#10;  @act6 controller_state ≔ VentilationOff_C&#10;  @act7 is_ventilating ≔ FALSE&#10;end&#10;&#10;&#10;event ActivatePressureAlarm&#10;where&#10;  @grd1 alarm_state = Inactive&#10;  @grd2 (pressure_reading ≤ MIN_PRESSURE_ALRM ∨ pressure_reading &gt; MAX_PRESSURE_ALRM)&#10;then&#10;  @act1 alarm_state ≔ Active&#10;  @act2 alarm_type ≔ PressureAlarm&#10;  @act3 is_alarm_displayed ≔ TRUE&#10;&#10;  @act4 is_gui_frozen ≔ FALSE&#10;  @act5 gui_state ≔ AlarmScreen_GUI&#10;&#10;  @act6 controller_state ≔ VentilationOff_C&#10;  @act7 is_ventilating ≔ FALSE&#10;end&#10;&#10;&#10;event ActivateTemperatureAlarm&#10;where&#10;  @grd1 alarm_state = Inactive&#10;  @grd2 (temperature_reading ≤ MIN_TEMPERATURE ∨ temperature_reading &gt; MAX_TEMPERATURE)&#10;then&#10;  @act1 alarm_state ≔ Active&#10;  @act2 alarm_type ≔ TemperatureAlarm&#10;  @act3 is_alarm_displayed ≔ TRUE&#10;&#10;  @act4 is_gui_frozen ≔ FALSE&#10;  @act5 gui_state ≔ AlarmScreen_GUI&#10;&#10;  @act6 controller_state ≔ VentilationOff_C&#10;  @act7 is_ventilating ≔ FALSE&#10;end&#10;&#10;&#10;  event AcknowledgeAlarm&#10;  where&#10;    @grd1 alarm_state = Active&#10;    @grd2 controller_state ≠ FailSafe_C&#10;  then&#10;    @act1 alarm_state ≔ Acknowledged&#10;  end&#10;&#10;&#10;  event EscalateToFailSafe&#10;  where&#10;    @grd1 alarm_state ∈ {Active, Acknowledged}&#10;    @grd2 controller_state = VentilationOff_C&#10;    @grd3 ( (alarm_type = BatteryAlarm ∧ battery_level ≤ CRITICAL_BATTERY_THRESHOLD) ∨&#10;           (alarm_type = VoltageAlarm ∧ (voltage_level ≤ CRITICAL_VOLTAGE_LOW ∨ voltage_level ≥ CRITICAL_VOLTAGE_HIGH)) ∨&#10;           (alarm_type = PressureAlarm ∧ pressure_reading ≥ CRITICAL_PRESSURE_THRESHOLD) ∨&#10;           (alarm_type = TemperatureAlarm ∧ temperature_reading ≥ CRITICAL_TEMPERATURE_THRESHOLD) )&#10;  then&#10;    @act1 controller_state ≔ FailSafe_C&#10;    @act2 is_ventilating ≔ TRUE&#10;    @act3 resp_rate ≔ DEFAULT_RESP_RATE_FAILSAFE&#10;    @act4 insp_pressure ≔ DEFAULT_INSP_PRESSURE_FAILSAFE&#10;  end&#10;&#10;  event DeactivateAlarm_System&#10;  where&#10;    @grd1 alarm_state ∈ {Active, Acknowledged}&#10;    @grd2 (alarm_type = BatteryAlarm ⇒ battery_level ≥ MIN_BATTERY_TIME) ∧&#10;          (alarm_type = VoltageAlarm ⇒ voltage_level ≥ MIN_VOLTAGE ∧ voltage_level ≤ MAX_VOLTAGE) ∧&#10;          (alarm_type = PressureAlarm ⇒ pressure_reading ≥ MIN_PRESSURE_ALRM ∧ pressure_reading ≤ MAX_PRESSURE_ALRM) ∧&#10;          (alarm_type = TemperatureAlarm ⇒ temperature_reading ≥ MIN_TEMPERATURE ∧ temperature_reading ≤ MAX_TEMPERATURE)&#10;  then&#10;    @act1 alarm_state ≔ Inactive&#10;    @act2 alarm_type ≔ NoAlarm&#10;    @act3 is_alarm_displayed ≔ FALSE&#10;&#10;    @act4 controller_state ≔ VentilationOff_C&#10;    @act5 is_ventilating ≔ FALSE&#10;    @act6 resp_rate ≔ DEFAULT_RESP_RATE&#10;    @act7 insp_pressure ≔ DEFAULT_INSP_PRESSURE&#10;    @act8 ie_ratio ≔ DEFAULT_IE_RATIO&#10;&#10;    @act9 is_gui_frozen ≔ FALSE&#10;    @act10 gui_state ≔ Ventilation_GUI&#10;  end&#10;&#10;  event PowerOff_System&#10;  where&#10;    @grd1 TRUE = TRUE&#10;  then&#10;    @act1 controller_state ≔ PowerOff_C&#10;    @act2 gui_state ≔ PowerOff_GUI&#10;    @act3 is_ventilating ≔ FALSE&#10;    @act4 is_gui_frozen ≔ FALSE&#10;&#10;    @act5 alarm_state ≔ Inactive&#10;    @act6 alarm_type ≔ NoAlarm&#10;    @act7 is_alarm_displayed ≔ FALSE&#10;  end&#10;end&#10;" version="5">
